{
  "name": "bento-pdf",
  "private": true,
  "version": "2.8.4",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/generate-sitemap.mjs && node scripts/generate-security-headers.mjs && node scripts/seo-audit.mjs",
    "build:with-docs": "npm run build && node scripts/include-docs-in-dist.js",
    "build:gzip": "cross-env COMPRESSION_MODE=g npm run build",
    "build:brotli": "cross-env COMPRESSION_MODE=b npm run build",
    "build:original": "cross-env COMPRESSION_MODE=o npm run build",
    "build:all": "cross-env COMPRESSION_MODE=all npm run build",
    "build:production": "cross-env VITE_USE_CDN=true npm run build:with-docs",
    "preview": "vite preview",
    "obfuscate": "node scripts/build.mjs",
    "build:docker": "vite build",
    "release": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "serve:simple": "cross-env SIMPLE_MODE=true npm run build && npm run preview -- --port 3000",
    "serve": "npm run build && npm run preview -- --port 3000",
    "package": "node scripts/package-dist.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
